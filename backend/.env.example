# Server
NODE_ENV=development
PORT=5000

# Database (Neon / Supabase / Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/devhire?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_access
JWT_REFRESH_SECRET=change_this_to_a_long_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CLIENT_URL=http://localhost:5173