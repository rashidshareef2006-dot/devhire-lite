# ─── Server ───
NODE_ENV=development
PORT=5000

# ─── Database (Neon / Supabase / Local Postgres) ───
# Pooled connection (app runtime — Neon pooler)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
# Direct connection (Prisma CLI / migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# ─── JWT (min 32 chars, random) ───
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_random
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_random
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Email (Gmail App Password for SMTP) ───
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=DevHire Lite

# ─── CORS ───
CLIENT_URL=http://localhost:5173

# ─── Admin Panel ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
ADMIN_JWT_SECRET=change_me_admin_jwt_secret_min_32_chars